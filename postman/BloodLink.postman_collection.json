    {
      "name": "01 Auth — Donor Register",
      "item": [
        {
          "name": "1. check-email (new donor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{coreApiUrl}}/auth/check-email",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{donorEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is not_found\", () => { const j = pm.response.json(); pm.expect(j.data.status).to.eql(\"not_found\"); pm.expect(j.data.otpSent).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. verify-otp — paste the code you received",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{coreApiUrl}}/auth/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{donorEmail}}\",\n  \"code\": \"{{otpCode}}\",\n  \"purpose\": \"register\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"valid true\", () => pm.expect(pm.response.json().data.valid).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. set-password (creates the user, returns token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{coreApiUrl}}/auth/set-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{donorEmail}}\",\n  \"password\": \"Test1234!\",\n  \"purpose\": \"register\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "  pm.collectionVariables.set(\"token\", json.data.token);",
                  "  pm.collectionVariables.set(\"userId\", json.data.user.id);",
                  "  console.log(\"Saved token + userId for\", json.data.user.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "check-email (existing, registered)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{coreApiUrl}}/auth/check-email",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{donorEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is registered\", () => pm.expect(pm.response.json().data.status).to.eql(\"registered\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{coreApiUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{donorEmail}}\",\n  \"password\": \"Test1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "  pm.collectionVariables.set(\"token\", json.data.token);",
                  "  pm.collectionVariables.set(\"userId\", json.data.user.id);",
                  "  console.log(\"Saved token + userId for\", json.data.user.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "resend-otp",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{coreApiUrl}}/auth/resend-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{donorEmail}}\",\n  \"purpose\": \"register\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "forgot-password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{coreApiUrl}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{donorEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "reset-password — paste the reset code you received",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{coreApiUrl}}/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{donorEmail}}\",\n  \"code\": \"{{otpCode}}\",\n  \"newPassword\": \"NewTest1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ],
      "description": "Set `donorEmail` in the environment to a real inbox you can read (defaults to the Gmail you gave me). Run 1→2→3 in order the first time; after that just use 'login'."
